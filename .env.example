NODE_ENV=development
PORT=4000
MEDIBOOK_PORT=4100
DATABASE_URL=
MONGO_URL=
DATA_DIR=.data
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
TRUST_PROXY_HOPS=0
JSON_BODY_LIMIT=1mb
JWT_SECRET=change-this-before-production
WEBHOOK_ENCRYPTION_KEY=local-webhook-encryption-key-change-before-production
ADMIN_EMAIL=admin@mediassist.local
ADMIN_PASSWORD=change-this-demo-password
MEDIBOOK_BASE_URL=http://localhost:4100
MEDIBOOK_SERVICE_KEY=local-medibook-service-key
MEDIBOOK_WEBHOOK_SECRET=local-medibook-webhook-secret
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
MOCK_LLM=true
STORE_RAW_NOTES=false
REQUIRE_ADMIN_MFA=false
CLINICAL_NOTE_RETENTION_DAYS=0
EVENT_RECEIPT_RETENTION_DAYS=14
WEBHOOK_DELIVERY_RETENTION_DAYS=90
AUTOMATION_RUN_RETENTION_DAYS=90
WEBHOOK_BACKOFF_SCALE=0.05
WEBHOOK_POLL_MS=1000
CORS_ADMIN_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000
